<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AdbApp.Maui.Views.AdbPage"
             Title="{Binding Title}"
             Padding="8">

    <Grid RowDefinitions="Auto,* ,Auto,Auto" RowSpacing="8">
        <SearchBar Grid.Row="0"
                   Placeholder="Filter output"
                   Text="{Binding Filter, Mode=TwoWay}" />

        <CollectionView x:Name="OutputCollectionView"
                        Grid.Row="1"
                        ItemsSource="{Binding FilterOutput}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="2">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer NumberOfTapsRequired="2"
                                                  Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.CopyCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <Label Text="{Binding .}"
                               LineBreakMode="CharacterWrap" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Text="fire command"
                    Command="{Binding GetAdbCommand}"
                    CommandParameter="{Binding Command}" />
            <Entry Grid.Column="1"
                   Text="{Binding Command, Mode=TwoWay}" />
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
            <Button Grid.Column="0"
                    Text="Cancel"
                    Command="{Binding CancelCommand}" />
            <Button Grid.Column="1"
                    Text="Clear"
                    Command="{Binding ClearCommand}" />
            <Label Grid.Column="2"
                   VerticalTextAlignment="Center"
                   HorizontalTextAlignment="End"
                   Text="{Binding OutputCount, StringFormat='Entries {0}'}" />
        </Grid>
    </Grid>
</ContentPage>
