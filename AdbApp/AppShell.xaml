<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AdbApp.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AdbApp.Maui.Views">

    <FlyoutItem Title="adb shell" Route="AdbPage">
        <ShellContent ContentTemplate="{DataTemplate views:AdbPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Predefined Commands" Route="PredefinedCommandPage">
        <ShellContent ContentTemplate="{DataTemplate views:PredefinedCommandPage}" />
    </FlyoutItem>

    <FlyoutItem Title="About" Route="AboutPage">
        <ShellContent ContentTemplate="{DataTemplate views:AboutPage}" />
    </FlyoutItem>
</Shell>
