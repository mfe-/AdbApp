<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>AdbApp.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>AdbApp</ApplicationTitle>
    <ApplicationId>get.the.solution.AdbApp</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>

    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <AndroidTargetSdkVersion>36</AndroidTargetSdkVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <AndroidManifest>..\AdbApp.Maui.Android\Properties\AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <JavaSdkDirectory>$(HOME)/.local/jdk-21</JavaSdkDirectory>
    <AndroidSdkDirectory>$(HOME)/.android-sdk</AndroidSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <Compile Include="..\AdbApp.Maui.Android\*.cs" Link="AdbApp.Maui.Android\%(Filename)%(Extension)" />
    <AndroidResource Include="..\AdbApp.Maui.Android\Resources\**\*.*" Link="Resources\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
